<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- HTTP en claro SOLO en debug: es lo que permite apuntar el telefono al
         backend corriendo en la LAN o por `adb reverse`. En release no existe,
         asi que un APK de produccion no puede hablar por http aunque alguien
         le pase una URL sin TLS al compilar. -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
