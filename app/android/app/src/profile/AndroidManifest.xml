<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Igual que en debug: HTTP en claro para poder apuntar a la LAN o al
         tunel de `adb reverse`. Profile es un build de desarrollo, compilado
         AOT: sirve para probar en el telefono a velocidad real sin renunciar
         a hablar con un backend local. En release esto no existe. -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
