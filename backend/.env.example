# Clave que la app Flutter manda en el header X-API-Key
APP_API_KEY=cambia-esto-por-un-secreto-largo

# Transcripcion diarizada (ElevenLabs Scribe). Es el motor principal; si falla
# o falta la llave, /v1/transcripciones cae al respaldo con Whisper.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=scribe_v2
# ElevenLabs no distingue variantes regionales: no hay es-419, solo es.
# Vacio = deteccion automatica, peor con ruido de campo.
ELEVENLABS_LANGUAGE=es

# Respaldo de transcripcion cuando ElevenLabs no responde. Whisper no separa
# voces: devuelve el texto con marcas de tiempo reales y sin hablante, y lo
# dice en la respuesta. Sin esta llave, una caida del proveedor deja el tramo
# sin transcribir y una visita ya hecha no se puede repetir.
OPENAI_API_KEY=
# Tiene que ser whisper-1: es el unico modelo de audio de OpenAI con
# verbose_json, y sin el no hay segmentos con marca de tiempo.
WHISPER_MODEL=whisper-1

# Informe (Claude)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5

# Airtable
AIRTABLE_TOKEN=pat...
AIRTABLE_BASE_ID=app...
AIRTABLE_TABLE=Reuniones

# Bucket del audio (R2/S3). Las credenciales viven SOLO aqui, nunca en la app.
# Bucket S3 para audio y fotos.
# En AWS deja BUCKET_ENDPOINT vacio: boto3 lo deduce de la region. Solo se
# llena para los compatibles (R2, B2, MinIO).
BUCKET_ENDPOINT=
BUCKET_NAME=sirius-agro-campo
BUCKET_ACCESS_KEY=
BUCKET_SECRET_KEY=
# AWS exige una region real. "auto" es de Cloudflare R2 y aqui falla.
BUCKET_REGION=us-east-1
# Solo si hay CDN o dominio propio delante del bucket. Vacio en AWS.
BUCKET_PUBLIC_URL=

# Login contra Sirius Nomina Core (tabla Personal, hash bcrypt).
# Conviene un PAT DISTINTO al del agro y de solo lectura sobre Personal: ese
# token tambien puede leer salarios y cuentas bancarias.
NOMINA_TOKEN=pat...
NOMINA_BASE_ID=app...
NOMINA_TABLE=Personal
# Hasta que orden jerarquico se es Coordinador en esta app (1 = Super Admin).
NOMINA_ORDEN_COORDINADOR=2
# Dias que el telefono puede validar la contrasena sin red antes de exigir
# un login con internet, que es lo unico que ve si la persona sigue activa.
DIAS_MAX_OFFLINE=30
